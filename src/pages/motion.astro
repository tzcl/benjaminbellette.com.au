---
import Slider from "../components/dynamic/Slider.svelte";
import ProjectCard from "../components/static/ProjectCard.astro";
import data from "../data/motion";
import { reel } from "../data/reel";
import Page from "../layouts/Page.astro";
---

<Page
  title="Benjamin Bellette | Motion"
  description="Cinematography portfolio featuring films, web series, music videos, commercials, documentaries and live broadcasts."
>
  <Slider client:idle title="Motion" pics={data.pics} />
  <section id="reel">
    <h2 class="subtitle">Reel</h2>
    <iframe
      src={reel.src + "&title=0&byline=0&portrait=0"}
      title={reel.title}
      width="100%"
      height="100%"
      allow="autoplay; fullscreen; picture-in-picture;"
      allowfullscreen
      class="w-main mx-auto my-12 aspect-video border-0"></iframe>
  </section>
  {
    data.trailers.map((section) => (
      <section id={section.id}>
        <h2 class="subtitle">{section.title}</h2>
        <div class="w-main mx-auto my-16">
          <ProjectCard project={section.tiles[0]} />
        </div>
      </section>
    ))
  }
  {
    data.sections.map((section) => (
      <section id={section.id}>
        <h2 class="subtitle">{section.title}</h2>
        <div class="m-8 grid grid-cols-1 justify-center gap-8 md:grid-cols-2 lg:grid-cols-6">
          {section.tiles.map((project, index) => (
            <div
              class:list={[
                section.featuredCount && index < section.featuredCount
                  ? "lg:col-span-3"
                  : "lg:col-span-2",
              ]}
            >
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>
    ))
  }
  <section>
    <h2 class="p-4">Interested in seeing more?</h2>
    <p class="my-12 text-center">
      <a href="https://vimeo.com/benbellette" class="group hover:text-grey-400">
        View portfolio <span
          class="inline-block transition-transform ease-linear group-hover:translate-x-1"
          >»</span
        >
      </a>
    </p>
  </section>
</Page>

<style>
  .w-main {
    width: min(60rem, 90%);
  }
</style>
